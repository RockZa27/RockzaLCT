{
  "name": "@rockzalct/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RockzaLCT desktop app (Electron + React)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist:win": "electron-vite build && node scripts/dist.mjs --win nsis --x64",
    "pack:dir": "electron-vite build && node scripts/dist.mjs --dir --linux"
  },
  "dependencies": {
    "@novastar/codec": "^2.2.3",
    "@novastar/native": "^2.5.1",
    "@novastar/net": "^2.2.3",
    "@novastar/serial": "^2.2.1",
    "@novastar/taurus": "0.4.1",
    "@rockzalct/device": "workspace:*",
    "@rockzalct/shared": "workspace:*",
    "@rockzalct/simulator": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "author": "RockzaLCT",
  "build": {
    "appId": "com.rockzalct.app",
    "productName": "RockzaLCT",
    "copyright": "RockzaLCT",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@rockzalct/**",
      "!**/*.{md,map,tsbuildinfo}",
      "!**/node_modules/@serialport/bindings-cpp/src/**",
      "!**/node_modules/@serialport/bindings-cpp/prebuilds/{android-*,darwin-*,linux-arm*,linux-ia32,win32-arm64,win32-ia32}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@serialport/bindings-cpp/prebuilds/**",
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RockzaLCT-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RockzaLCT"
    }
  }
}
